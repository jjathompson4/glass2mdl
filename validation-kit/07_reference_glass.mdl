mdl 1.6;

import ::anno::*;
import ::df::*;

// Control: ordinary 6mm clear glass
//
// Setup: Apply to a 6mm-thick box. Everything else is compared against
// this.
//
// Expected: About 8% reflectance and 88% transmittance measured at normal
// incidence.

// Control sample. 6mm clear float, Fresnel from the material IOR.

export material test07_reference_glass()
[[
    anno::display_name("07 reference 6mm clear"),
    anno::description("07 reference 6mm clear"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: false,
    surface: material_surface(
        scattering: df::specular_bsdf(
            tint: color(1.0, 1.0, 1.0),
            mode: df::scatter_reflect_transmit
        )
    ),
    ior: color(1.52),
    volume: material_volume(
        absorption_coefficient: color(7.15125, 7.15125, 7.15125)
    )
);
