mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Flood coat IGU — planar export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - planar export
// System: Flood coat IGU
//
// Data sheet input:
//   Visible transmittance (VLT): 70.0%
//   Visible reflectance, exterior: 11.0%
//   Visible reflectance, interior: 12.0%
//   Lite 1: 6mm Clear float, low-e coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//   Spandrel: flood coat on surface #4, manufacturer chart, warm gray (#4B4B52)
//
// Fitted result:
//   Transmittance: 70.0% (residual 0.00 pts)
//   Reflectance ext: 11.0% (residual -0.00 pts)
//   Reflectance int: 12.0% (residual -0.00 pts)
//   Spandrel reads as, from outside: 12.5% (#606368); the finish colour is taken as given, nothing transmits
//
// Notes:
//   - Apply to a single flat surface with no thickness. Do not use on a solid.
//   - Opaque spandrel: the whole build-up over a flood coat on surface #4, manufacturer chart, warm gray (#4B4B52), collapsed to one surface. Nothing transmits.
//   - Seen from outside the panel reads as 12.5%; the finish colour is taken as given, since no data sheet measures it.
//   - The interior side is a dark neutral: what sits behind a spandrel is insulation or a pan, never glass.
//   - Roller wave: wire the bundled roller_wave_bump.png into the material's geometry normal channel in Max (see the README). Assumes 1 UV unit = 1 meter.

export material flood_coat_igu_planar()
[[
    anno::display_name("Flood coat IGU (planar)"),
    anno::description("Spandrel: whole build-up plus flood coat on #4, as a single opaque surface."),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.096513,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(0.859999, 0.908313, 1.0),
                mode: df::scatter_reflect
            ),
            base: df::diffuse_reflection_bsdf(
                tint: color(0.038883, 0.042354, 0.04551)
            )
        )
    ),
    backface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.06, 0.06, 0.06)
        )
    ),
    ior: color(1.52)
);
