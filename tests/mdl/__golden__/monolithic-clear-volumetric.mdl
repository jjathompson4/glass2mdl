mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Clear 6mm — volumetric export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - volumetric export
// System: Clear 6mm
//
// Data sheet input:
//   Visible transmittance (VLT): 88.0%
//   Visible reflectance, exterior: 8.0%
//   Visible reflectance, interior: 8.0%
//   Lite 1: 6mm Clear float
//
// Fitted result:
//   Transmittance: 88.0% (residual 0.00 pts)
//   Reflectance ext: 7.8% (residual -0.15 pts)
//   Reflectance int: 7.8% (residual -0.15 pts)
//
// Notes:
//   - Apply to lite 1 of 1, modeled as a 6mm thick solid.
//   - Absorption is per meter of travel, so the solid's real thickness must match the value above.

export material clear_6mm_monolithic(
    uniform float ior = 1.52
        [[
            anno::display_name("Index of refraction"),
            anno::description("Drives the real Fresnel split and refraction. 1.52 is architectural float glass.")
        ]]
)
[[
    anno::display_name("Clear 6mm - monolithic lite"),
    anno::description("6mm Clear float"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: false,
    surface: material_surface(
        scattering: df::specular_bsdf(
            tint: color(1.0, 1.0, 1.0),
            mode: df::scatter_reflect_transmit
        )
    ),
    ior: color(ior),
    volume: material_volume(
        absorption_coefficient: color(9.512109, 6.033092, 10.393444)
    )
);
