mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Lab specified IGU — planar export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - planar export
// System: Lab specified IGU
//
// Cutsheet input:
//   Visible transmittance (VLT): 70.0%
//   Visible reflectance, exterior: 11.0%
//   Visible reflectance, interior: 12.0%
//   Lite 1: 6mm Clear float, low-e coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//
// Fitted result:
//   Transmittance: 70.0% (residual -0.00 pts)
//   Reflectance ext: 11.0% (residual -0.00 pts)
//   Reflectance int: 12.0% (residual 0.00 pts)
//
// Notes:
//   - Apply to a single flat surface with no thickness. Do not use on a solid.
//   - Interior appearance comes from the material's backface; keep face normals pointing outward.

export material lab_specified_igu_planar()
[[
    anno::display_name("Lab specified IGU (planar)"),
    anno::description("Whole glazing assembly as a single thin surface."),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.141973,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(0.614776, 0.799628, 1.0),
                mode: df::scatter_reflect
            ),
            base: df::specular_bsdf(
                tint: color(0.76745, 0.832213, 0.795928),
                mode: df::scatter_transmit
            )
        )
    ),
    backface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.126779,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(1.0, 0.937477, 0.87877),
                mode: df::scatter_reflect
            ),
            base: df::specular_bsdf(
                tint: color(0.754097, 0.817733, 0.782079),
                mode: df::scatter_transmit
            )
        )
    ),
    ior: color(1.52)
);
