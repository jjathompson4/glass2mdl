// System: Pinned coating IGU
//
// Cutsheet input:
//   Visible transmittance (VLT): 35.0%
//   Visible reflectance, exterior: 28.0%
//   Visible reflectance, interior: 24.0%
//   Lite 1: 6mm Clear float, reflective coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//
// Fitted result:
//   Transmittance: 35.0% (residual 0.00 pts)
//   Reflectance ext: 28.5% (residual 0.49 pts)
//   Reflectance int: 24.0% (residual -0.00 pts)
//
// Notes:
//   - Apply to a single flat surface with no thickness. Do not use on a solid.
//   - Interior appearance comes from the material's backface; keep face normals pointing outward.

export material pinned_coating_igu_planar()
[[
    anno::display_name("Pinned coating IGU (planar)"),
    anno::description("Whole glazing assembly as a single thin surface."),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.299855,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(0.897881, 0.96041, 1.0),
                mode: df::scatter_reflect
            ),
            base: df::specular_bsdf(
                tint: color(0.485416, 0.50618, 0.480293),
                mode: df::scatter_transmit
            )
        )
    ),
    backface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.24,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(1.0, 1.0, 1.0),
                mode: df::scatter_reflect
            ),
            base: df::specular_bsdf(
                tint: color(0.447186, 0.466315, 0.442467),
                mode: df::scatter_transmit
            )
        )
    ),
    ior: color(1.52)
);
