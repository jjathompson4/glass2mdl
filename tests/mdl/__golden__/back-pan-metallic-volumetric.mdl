mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Back pan metallic — volumetric export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - volumetric export
// System: Back pan metallic
//
// Data sheet input:
//   Visible transmittance (VLT): 88.0%
//   Visible reflectance, exterior: 8.0%
//   Visible reflectance, interior: 8.0%
//   Lite 1: 6mm Clear float
//   Spandrel: metallic back pan 50mm behind the glass, clear anodized (#9EA2A6)
//
// Fitted result:
//   Transmittance: 88.0% (residual 0.00 pts)
//   Reflectance ext: 7.8% (residual -0.15 pts)
//   Reflectance int: 7.8% (residual -0.15 pts)
//   Spandrel reads as, from outside: 36.4% (#9EA4A4); the finish colour is taken as given, nothing transmits
//
// Notes:
//   - Apply to lite 1 of 1, modeled as a 6mm thick solid.
//   - Absorption is per meter of travel, so the solid's real thickness must match the value above.

export material back_pan_metallic_monolithic(
    uniform float ior = 1.52
        [[
            anno::display_name("Index of refraction"),
            anno::description("Drives the real Fresnel split and refraction. 1.52 is architectural float glass.")
        ]]
)
[[
    anno::display_name("Back pan metallic - monolithic lite"),
    anno::description("6mm Clear float"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: false,
    surface: material_surface(
        scattering: df::specular_bsdf(
            tint: color(1.0, 1.0, 1.0),
            mode: df::scatter_reflect_transmit
        )
    ),
    ior: color(ior),
    volume: material_volume(
        absorption_coefficient: color(9.512109, 6.033092, 10.393444)
    )
);

// Generated by glass2mdl 0.1.0 - volumetric export
// System: Back pan metallic
//
// Data sheet input:
//   Visible transmittance (VLT): 88.0%
//   Visible reflectance, exterior: 8.0%
//   Visible reflectance, interior: 8.0%
//   Lite 1: 6mm Clear float
//   Spandrel: metallic back pan 50mm behind the glass, clear anodized (#9EA2A6)
//
// Fitted result:
//   Transmittance: 88.0% (residual 0.00 pts)
//   Reflectance ext: 7.8% (residual -0.15 pts)
//   Reflectance int: 7.8% (residual -0.15 pts)
//   Spandrel reads as, from outside: 36.4% (#9EA4A4); the finish colour is taken as given, nothing transmits
//
// Notes:
//   - Apply to the metal back pan sitting 50mm behind the innermost lite; the same material goes on every face, so Material IDs do not matter here.
//   - In the apply script: pick 'back_pan_metallic_pan' in the type list, select the pans in the viewport, Mark selection as this type, then Assign materials.
//   - metallic back pan 50mm behind the glass, clear anodized (#9EA2A6). Seen from outside through the glass the panel reads as 36.4%.

export material back_pan_metallic_pan()
[[
    anno::display_name("Back pan metallic - back pan"),
    anno::description("metallic back pan, 50mm behind the glass"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(
            roughness_u: 0.3,
            tint: color(0.341914, 0.361307, 0.381326),
            mode: df::scatter_reflect
        )
    ),
    ior: color(1.52)
);
