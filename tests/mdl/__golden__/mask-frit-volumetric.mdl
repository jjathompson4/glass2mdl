mdl 1.6;

import ::anno::*;
import ::base::*;
import ::df::*;
import ::math::*;
import ::state::*;
import ::tex::*;

// glass2mdl 0.1.0 — MDL 1.6
// Custom mask frit — volumetric export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Frit coverage from custom_pattern.png (white = frit).
// Keep the image file next to this .mdl file.
export float custom_mask_frit_mask_coverage(uniform float scale = 1.0)
{
    return base::file_texture(
        texture: texture_2d("./custom_pattern.png", tex::gamma_linear),
        mono_source: base::mono_average,
        uvw: base::texture_coordinate_info(
            position: state::texture_coordinate(0) / scale
        )
    ).mono;
}

// Generated by glass2mdl 0.1.0 - volumetric export
// System: Custom mask frit
//
// Cutsheet input:
//   Visible transmittance (VLT): 70.0%
//   Visible reflectance, exterior: 11.0%
//   Visible reflectance, interior: 12.0%
//   Lite 1: 6mm Clear float, low-e coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//   Frit: texture on surface #2, opacity 90.0%
//
// Fitted result:
//   Transmittance: 70.0% (residual 0.00 pts)
//   Reflectance ext: 11.0% (residual -0.00 pts)
//   Reflectance int: 12.0% (residual -0.00 pts)
//
// Notes:
//   - Apply to lite 1 of 2, modeled as a 6mm thick solid.
//   - Absorption is per meter of travel, so the solid's real thickness must match the value above.
//   - Coating fitted for surface #2. Assign this material to the solid's face Material IDs: ID 1 = exterior face (interior_face off), ID 2 = cavity/interior face (interior_face on), ID 3 = edges (off). The bundled bind_manifest.json and the glass2mdl Max apply script automate the assignment.
//   - The volume carries the coating's absorption as well as the glass body's - the fitted faces only reflect and pass, so the divergence from the nominal body transmittance is intentional.

export material custom_mask_frit_outer(
    uniform bool interior_face = false
        [[
            anno::display_name("Interior face"),
            anno::description("Off for the exterior-facing face (Material ID 1) and edges (ID 3); on for the cavity/interior-facing face (Material ID 2).")
        ]]
)
[[
    anno::display_name("Custom mask frit - outer lite"),
    anno::description("6mm Clear float, low-e coating"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: false,
    surface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: interior_face ? 0.037224 : 0.046751,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: interior_face ? color(0.477876, 0.565762, 1.0) : color(0.96953, 0.987769, 1.0),
                mode: df::scatter_reflect
            ),
            base: df::specular_bsdf(
                tint: color(1.0, 1.0, 1.0),
                mode: df::scatter_transmit
            )
        )
    ),
    ior: color(1.52),
    volume: material_volume(
        absorption_coefficient: color(27.102851, 23.728561, 28.348168)
    )
);

// Generated by glass2mdl 0.1.0 - volumetric export
// System: Custom mask frit
//
// Cutsheet input:
//   Visible transmittance (VLT): 70.0%
//   Visible reflectance, exterior: 11.0%
//   Visible reflectance, interior: 12.0%
//   Lite 1: 6mm Clear float, low-e coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//   Frit: texture on surface #2, opacity 90.0%
//
// Fitted result:
//   Transmittance: 70.0% (residual 0.00 pts)
//   Reflectance ext: 11.0% (residual -0.00 pts)
//   Reflectance int: 12.0% (residual -0.00 pts)
//
// Notes:
//   - Apply to lite 2 of 2, modeled as a 6mm thick solid.
//   - Absorption is per meter of travel, so the solid's real thickness must match the value above.

export material custom_mask_frit_inner(
    uniform float ior = 1.52
        [[
            anno::display_name("Index of refraction"),
            anno::description("Drives the real Fresnel split and refraction. 1.52 is architectural float glass.")
        ]]
)
[[
    anno::display_name("Custom mask frit - inner lite"),
    anno::description("6mm Clear float"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: false,
    surface: material_surface(
        scattering: df::specular_bsdf(
            tint: color(1.0, 1.0, 1.0),
            mode: df::scatter_reflect_transmit
        )
    ),
    ior: color(ior),
    volume: material_volume(
        absorption_coefficient: color(9.428392, 5.937863, 10.312567)
    )
);

// Generated by glass2mdl 0.1.0 - volumetric export
// System: Custom mask frit
//
// Cutsheet input:
//   Visible transmittance (VLT): 70.0%
//   Visible reflectance, exterior: 11.0%
//   Visible reflectance, interior: 12.0%
//   Lite 1: 6mm Clear float, low-e coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//   Frit: texture on surface #2, opacity 90.0%
//
// Fitted result:
//   Transmittance: 70.0% (residual 0.00 pts)
//   Reflectance ext: 11.0% (residual -0.00 pts)
//   Reflectance int: 12.0% (residual -0.00 pts)
//
// Notes:
//   - Apply to a flat plane placed on surface #2: the interior-facing face of lite 1.
//   - Offset the plane about 0.1mm off the glass face so the renderer does not have to break a tie between coincident surfaces.
//   - Frit pattern assumes 1 UV unit = 1 meter (a 1 m x 1 m UVW Map, or Real-World Map Size).

export material custom_mask_frit_frit_decal(
    uniform float frit_pattern_scale = 1.0
        [[
            anno::display_name("Frit pattern scale"),
            anno::description("Multiplies the pattern's physical size. Leave at 1.0 when the plane uses a 1 m x 1 m UVW map.")
        ]]
)
[[
    anno::display_name("Custom mask frit - frit decal"),
    anno::description("texture frit for surface #2"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::normalized_mix(
            components: df::bsdf_component[](
                df::bsdf_component(
                    weight: 0.9,
                    component: df::diffuse_reflection_bsdf(
                        tint: color(0.95, 0.95, 0.93)
                    )
                ),
                df::bsdf_component(
                    weight: 0.1,
                    component: df::diffuse_transmission_bsdf(
                        tint: color(0.95, 0.95, 0.93)
                    )
                )
            )
        )
    ),
    ior: color(1.52),
    geometry: material_geometry(
        cutout_opacity: custom_mask_frit_mask_coverage(frit_pattern_scale)
    )
);
