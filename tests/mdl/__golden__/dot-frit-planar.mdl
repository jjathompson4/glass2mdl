mdl 1.6;

import ::anno::*;
import ::df::*;
import ::math::*;
import ::state::*;

// glass2mdl 0.1.0 — MDL 1.6
// Dot frit IGU — planar export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Dot frit: 6mm dots on 12mm centres.
// Coverage 19.6%.
export float dot_frit_igu_dot_coverage(uniform float scale = 1.0)
{
    float pitch = 0.012 * scale;
    float3 uvw = state::texture_coordinate(0);
    float2 cell = float2(uvw.x, uvw.y) / pitch;
    float2 offset = cell - float2(math::floor(cell.x), math::floor(cell.y)) - float2(0.5, 0.5);
    float dist = math::length(offset) * pitch;
    float radius = 0.003 * scale;
    float edge = 0.00018 * scale;
    return 1.0 - math::smoothstep(radius - edge, radius + edge, dist);
}

// Generated by glass2mdl 0.1.0 - planar export
// System: Dot frit IGU
//
// Cutsheet input:
//   Visible transmittance (VLT): 70.0%
//   Visible reflectance, exterior: 11.0%
//   Visible reflectance, interior: 12.0%
//   Lite 1: 6mm Clear float, low-e coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//   Frit: dots on surface #2, opacity 92.0%
//
// Fitted result:
//   Transmittance: 70.0% (residual 0.00 pts)
//   Reflectance ext: 11.0% (residual -0.00 pts)
//   Reflectance int: 12.0% (residual -0.00 pts)
//
// Notes:
//   - Apply to a single flat surface with no thickness. Do not use on a solid.
//   - Interior appearance comes from the material's backface; keep face normals pointing outward.
//   - Frit pattern assumes 1 UV unit = 1 meter (a 1 m x 1 m UVW Map, or Real-World Map Size).
//   - If the pattern looks the wrong size in Max, adjust frit_pattern_scale rather than regenerating.

export material dot_frit_igu_planar(
    uniform float frit_pattern_scale = 1.0
        [[
            anno::display_name("Frit pattern scale"),
            anno::description("Multiplies the pattern's physical size. Leave at 1.0 when the object uses a 1 m x 1 m UVW map.")
        ]]
)
[[
    anno::display_name("Dot frit IGU (planar)"),
    anno::description("Whole glazing assembly as a single thin surface. Includes dots frit."),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::weighted_layer(
            weight: dot_frit_igu_dot_coverage(frit_pattern_scale),
            layer: df::normalized_mix(
                components: df::bsdf_component[](
                    df::bsdf_component(
                        weight: 0.92,
                        component: df::diffuse_reflection_bsdf(
                            tint: color(0.9, 0.9, 0.88)
                        )
                    ),
                    df::bsdf_component(
                        weight: 0.08,
                        component: df::diffuse_transmission_bsdf(
                            tint: color(0.9, 0.9, 0.88)
                        )
                    )
                )
            ),
            base: df::custom_curve_layer(
                normal_reflectivity: 0.117441,
                grazing_reflectivity: 1.0,
                exponent: 5.0,
                layer: df::specular_bsdf(
                    tint: color(0.888889, 0.944444, 1.0),
                    mode: df::scatter_reflect
                ),
                base: df::specular_bsdf(
                    tint: color(0.770172, 0.803117, 0.762044),
                    mode: df::scatter_transmit
                )
            )
        )
    ),
    backface: material_surface(
        scattering: df::weighted_layer(
            weight: dot_frit_igu_dot_coverage(frit_pattern_scale),
            layer: df::normalized_mix(
                components: df::bsdf_component[](
                    df::bsdf_component(
                        weight: 0.92,
                        component: df::diffuse_reflection_bsdf(
                            tint: color(0.9, 0.9, 0.88)
                        )
                    ),
                    df::bsdf_component(
                        weight: 0.08,
                        component: df::diffuse_transmission_bsdf(
                            tint: color(0.9, 0.9, 0.88)
                        )
                    )
                )
            ),
            base: df::custom_curve_layer(
                normal_reflectivity: 0.128117,
                grazing_reflectivity: 1.0,
                exponent: 5.0,
                layer: df::specular_bsdf(
                    tint: color(0.888889, 0.944444, 1.0),
                    mode: df::scatter_reflect
                ),
                base: df::specular_bsdf(
                    tint: color(0.779603, 0.812952, 0.771375),
                    mode: df::scatter_transmit
                )
            )
        )
    ),
    ior: color(1.52)
);
