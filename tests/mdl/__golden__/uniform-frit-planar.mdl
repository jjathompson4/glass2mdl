mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Uniform frit monolithic — planar export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - planar export
// System: Uniform frit monolithic
//
// Data sheet input:
//   Visible transmittance (VLT): 88.0%
//   Visible reflectance, exterior: 8.0%
//   Visible reflectance, interior: 8.0%
//   Lite 1: 6mm Clear float
//   Frit: uniform on surface #2, opacity 95.0%
//
// Fitted result:
//   Transmittance: 88.0% (residual 0.00 pts)
//   Reflectance ext: 7.8% (residual -0.15 pts)
//   Reflectance int: 7.8% (residual -0.15 pts)
//
// Notes:
//   - Apply to a single flat surface with no thickness. Do not use on a solid.
//   - Interior appearance comes from the material's backface; keep face normals pointing outward.

export material uniform_frit_monolithic_planar()
[[
    anno::display_name("Uniform frit monolithic (planar)"),
    anno::description("Whole glazing assembly as a single thin surface. Includes uniform frit."),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::weighted_layer(
            weight: 0.4,
            layer: df::normalized_mix(
                components: df::bsdf_component[](
                    df::bsdf_component(
                        weight: 0.95,
                        component: df::diffuse_reflection_bsdf(
                            tint: color(0.9, 0.9, 0.9)
                        )
                    ),
                    df::bsdf_component(
                        weight: 0.05,
                        component: df::diffuse_transmission_bsdf(
                            tint: color(0.9, 0.9, 0.9)
                        )
                    )
                )
            ),
            base: df::custom_curve_layer(
                normal_reflectivity: 0.078947,
                grazing_reflectivity: 1.0,
                exponent: 5.0,
                layer: df::specular_bsdf(
                    tint: color(0.981134, 1.0, 0.976479),
                    mode: df::scatter_reflect
                ),
                base: df::specular_bsdf(
                    tint: color(0.941536, 0.961463, 0.936554),
                    mode: df::scatter_transmit
                )
            )
        )
    ),
    backface: material_surface(
        scattering: df::weighted_layer(
            weight: 0.4,
            layer: df::normalized_mix(
                components: df::bsdf_component[](
                    df::bsdf_component(
                        weight: 0.95,
                        component: df::diffuse_reflection_bsdf(
                            tint: color(0.9, 0.9, 0.9)
                        )
                    ),
                    df::bsdf_component(
                        weight: 0.05,
                        component: df::diffuse_transmission_bsdf(
                            tint: color(0.9, 0.9, 0.9)
                        )
                    )
                )
            ),
            base: df::custom_curve_layer(
                normal_reflectivity: 0.078947,
                grazing_reflectivity: 1.0,
                exponent: 5.0,
                layer: df::specular_bsdf(
                    tint: color(0.981134, 1.0, 0.976479),
                    mode: df::scatter_reflect
                ),
                base: df::specular_bsdf(
                    tint: color(0.941536, 0.961463, 0.936554),
                    mode: df::scatter_transmit
                )
            )
        )
    ),
    ior: color(1.52)
);
