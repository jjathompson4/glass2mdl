mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Flood coat monolithic — planar export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - planar export
// System: Flood coat monolithic
//
// Data sheet input:
//   Visible transmittance (VLT): 88.0%
//   Visible reflectance, exterior: 8.0%
//   Visible reflectance, interior: 8.0%
//   Lite 1: 6mm Clear float
//   Spandrel: flood coat on surface #2, RAL 7024 (#4A4D4F)
//
// Fitted result:
//   Transmittance: 88.0% (residual 0.00 pts)
//   Reflectance ext: 7.8% (residual -0.15 pts)
//   Reflectance int: 7.8% (residual -0.15 pts)
//   Spandrel reads as, from outside: 10.4% (#585C5C); the finish colour is taken as given, nothing transmits
//
// Notes:
//   - Apply to a single flat surface with no thickness. Do not use on a solid.
//   - Opaque spandrel: the whole build-up over a flood coat on surface #2, RAL 7024 (#4A4D4F), collapsed to one surface. Nothing transmits.
//   - Seen from outside the panel reads as 10.4%; the finish colour is taken as given, since no data sheet measures it.
//   - The interior side is a dark neutral: what sits behind a spandrel is insulation or a pan, never glass.

export material flood_coat_monolithic_planar()
[[
    anno::display_name("Flood coat monolithic (planar)"),
    anno::description("Spandrel: whole build-up plus flood coat on #2, as a single opaque surface."),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.04258,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(1.0, 1.0, 1.0),
                mode: df::scatter_reflect
            ),
            base: df::diffuse_reflection_bsdf(
                tint: color(0.058643, 0.066286, 0.066275)
            )
        )
    ),
    backface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.06, 0.06, 0.06)
        )
    ),
    ior: color(1.52)
);
