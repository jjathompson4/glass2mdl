mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Flood coat monolithic — volumetric export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - volumetric export
// System: Flood coat monolithic
//
// Data sheet input:
//   Visible transmittance (VLT): 88.0%
//   Visible reflectance, exterior: 8.0%
//   Visible reflectance, interior: 8.0%
//   Lite 1: 6mm Clear float
//   Spandrel: flood coat on surface #2, RAL 7024 (#4A4D4F)
//
// Fitted result:
//   Transmittance: 88.0% (residual 0.00 pts)
//   Reflectance ext: 7.8% (residual -0.15 pts)
//   Reflectance int: 7.8% (residual -0.15 pts)
//   Spandrel reads as, from outside: 10.4% (#585C5C); the finish colour is taken as given, nothing transmits
//
// Notes:
//   - Apply to lite 1 of 1, modeled as a 6mm thick solid.
//   - Absorption is per meter of travel, so the solid's real thickness must match the value above.
//   - Flood coat on surface #2: Material ID 2 (the interior face, interior_face on) renders the opaque paint in place of the glass; IDs 1 and 3 stay glass. The bundled manifest sets the parameter per ID.
//   - Seen from outside through this build-up the panel reads as 10.4%; the finish colour is taken as given, since no data sheet measures it.

export material flood_coat_monolithic_monolithic(
    uniform float ior = 1.52
        [[
            anno::display_name("Index of refraction"),
            anno::description("Drives the real Fresnel split and refraction. 1.52 is architectural float glass.")
        ]],
    uniform bool interior_face = false
        [[
            anno::display_name("Interior face"),
            anno::description("Off for the exterior-facing face (Material ID 1) and edges (ID 3); on for the flood-coated interior face (ID 2), which renders as the opaque paint.")
        ]]
)
[[
    anno::display_name("Flood coat monolithic - monolithic lite"),
    anno::description("6mm Clear float, flood coat on #2"),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: false,
    surface: material_surface(
        scattering: interior_face ? df::diffuse_reflection_bsdf(tint: color(0.068478, 0.074214, 0.078187)) : df::specular_bsdf(tint: color(1.0, 1.0, 1.0), mode: df::scatter_reflect_transmit)
    ),
    ior: color(ior),
    volume: material_volume(
        absorption_coefficient: color(9.512109, 6.033092, 10.393444)
    )
);
