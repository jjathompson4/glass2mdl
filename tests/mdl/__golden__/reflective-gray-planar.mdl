mdl 1.6;

import ::anno::*;
import ::df::*;

// glass2mdl 0.1.0 — MDL 1.6
// Reflective gray IGU — planar export
//
// Install: copy this folder into a directory listed as an MDL search path in
// Iray for 3ds Max, then pick the material from the Iray+ material browser.

// Generated by glass2mdl 0.1.0 - planar export
// System: Reflective gray IGU
//
// Data sheet input:
//   Visible transmittance (VLT): 20.0%
//   Visible reflectance, exterior: 32.0%
//   Visible reflectance, interior: 25.0%
//   Lite 1: 6mm Gray tint, reflective coating on surface #2
//   Gap 1: 12mm
//   Lite 2: 6mm Clear float
//
// Fitted result:
//   Transmittance: 2.0% (residual -17.97 pts)
//   Reflectance ext: 23.7% (residual -8.33 pts)
//   Reflectance int: 25.0% (residual -0.00 pts)
//
// Notes:
//   - Apply to a single flat surface with no thickness. Do not use on a solid.
//   - Interior appearance comes from the material's backface; keep face normals pointing outward.

export material reflective_gray_igu_planar()
[[
    anno::display_name("Reflective gray IGU (planar)"),
    anno::description("Whole glazing assembly as a single thin surface."),
    anno::author("glass2mdl 0.1.0")
]]
= material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.24091,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(1.0, 0.982607, 0.931559),
                mode: df::scatter_reflect
            ),
            base: df::specular_bsdf(
                tint: color(0.026679, 0.026958, 0.025449),
                mode: df::scatter_transmit
            )
        )
    ),
    backface: material_surface(
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.261173,
            grazing_reflectivity: 1.0,
            exponent: 5.0,
            layer: df::specular_bsdf(
                tint: color(0.933333, 0.96, 1.0),
                mode: df::scatter_reflect
            ),
            base: df::specular_bsdf(
                tint: color(0.02741, 0.027697, 0.026147),
                mode: df::scatter_transmit
            )
        )
    ),
    ior: color(1.52)
);
